<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".SmartMealPlannerApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMealPlannerAI"
        tools:targetApi="35">

        <!-- Splash Activity (Entry Point) -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartMealPlannerAI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activity (Login & Register) -->
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Hosts Bottom Navigation and Core Fragments) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- Meal Analysis Activity (Serving Size & Nutrient Calculation) -->
        <activity
            android:name=".ui.analysis.MealAnalysisActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Nutrition Dashboard & Trends Activity -->
        <activity
            android:name=".ui.nutrition.NutritionDashboardActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Meal History Log Activity -->
        <activity
            android:name=".ui.history.MealHistoryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Settings & Sync Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
