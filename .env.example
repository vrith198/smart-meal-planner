# ==============================================================================
# Smart Meal Planner AI - Environment Configuration Template
# DO NOT COMMIT REAL API KEYS TO THIS FILE OR TO VERSION CONTROL.
# Copy this file to '.env' for local Python ML scripts, or place in
# 'local.properties' for Android Studio local builds.
# ==============================================================================

# Google Gemini API Key (Multimodal AI Vision Agent)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# For Android Studio local builds, add the following line to local.properties:
# gemini.api.key=your_gemini_api_key_here

# Optional Backend Proxy URL (recommended for production Android deployments)
# BACKEND_AI_SERVICE_URL=https://your-cloud-backend.example.com/api/analyze-meal
